  <diagram id="diag_mod_inv" name="Modul 4: Inventaris, Master Produk &amp; Restock ACID">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m4_hdr" value="&lt;b&gt;MODUL 4: MANAJEMEN INVENTARIS, MASTER BARANG, KATEGORI &amp; ENGINE RESTOCK ACID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#94A3B8;&quot;&gt;StokPanel.java, RestockService.java, BarangDao.java, KategoriDao.java, RestockDao.java, LayananPanel.java&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontSize=15;align=center;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="25" width="900" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m4_from_nav" value="[FROM MODUL 1: NAVIGASI INVENTARIS]" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="115" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m4_prep" value="PREPARATION (Inventaris, Master Produk &amp; Restock Engine):
[IPO Context]:
• Input: Form Barang, Form Kategori, Form Layanan, Form Restock Masuk
• Process: Validasi Kode Unik, Restock ACID Transaction (Stok += Qty, Harga Beli Baru)
• Output: Master Table Update, Peringatan Stok Minimum (Badge Menipis/Habis)
[Deklarasi Variabel]:
• List&lt;Barang&gt; listBarang = []; List&lt;Kategori&gt; listKategori = []
• List&lt;Restock&gt; listRestock = []; Restock restock = null; int qty = 0" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="200" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="m4_dec_tab" value="Pilih Sub-Modul /
Tab Inventaris?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="925" y="355" width="150" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m4_tab_b" value="1. TAB BARANG &amp; STOK:
• Tambah/Edit Master Barang (Kode, Nama, Satuan, Harga Beli, Harga Jual, Stok Min)
• Deteksi Stok: HABIS (stok&lt;=0) / MENIPIS (stok&lt;=min)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="465" width="290" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m4_tab_k" value="2. TAB KATEGORI:
• Kelola Kategori Produk (ATK, Kertas, Tinta, Jilid)
• INSERT / UPDATE / DELETE kategori (FK SET NULL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1070" y="465" width="280" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m4_tab_l" value="3. TAB LAYANAN (Owner):
• Kelola Tarif Jasa Print &amp; Cetak (LayananPanel)
• INSERT / UPDATE / DELETE master tarif" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#581C87;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="565" width="290" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m4_inp_restock" value="4. TAB RESTOCK (Owner Only):
Input: Barang, Qty Masuk (&gt;0), Harga Beli Baru, Supplier, Catatan
Klik &#x27;SIMPAN RESTOCK&#x27;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1040" y="565" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m4_dec_r_val" value="Jumlah &gt; 0 &amp;
Barang Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1135" y="660" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m4_err_restock" value="Dialog Peringatan:
&#x27;Jumlah restock harus &gt; 0&#x27;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1340" y="670" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m4_sub_restock_acid" value="RestockService.simpan() (ACID TRANSACTION):
1. conn.setAutoCommit(false)
2. INSERT INTO restock (barang_id, jumlah, harga_beli, supplier, catatan, user_id)
3. UPDATE barang SET stok = stok + jumlah WHERE id = ?
4. Jika harga_beli &gt; 0: UPDATE barang SET harga_beli = ? WHERE id = ?
5. conn.commit()" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="770" width="440" height="105" as="geometry" />
        </mxCell>
        <mxCell id="m4_db_restock" value="Tabel restock &amp;
Tabel barang" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1410" y="780" width="150" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m4_sub_master_db" value="Eksekusi CRUD Master ke Database MySQL
BarangDao / KategoriDao / LayananDao" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#E0E7FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="790" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m4_db_master" value="Tabel barang,
kategori, layanan" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
