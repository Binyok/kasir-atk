  <diagram id="diag_mod_mgmt" name="Modul 5: Laporan, User &amp; Backup Database">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m5_hdr" value="&lt;b&gt;MODUL 5: MANAJEMEN OWNER — LAPORAN KEUANGAN, KELOLA PENGGUNA &amp; BACKUP DATABASE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#94A3B8;&quot;&gt;LaporanPanel.java, UserPanel.java, UserService.java, PengaturanPanel.java, BackupService.java, ExcelExporter.java&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontSize=15;align=center;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="25" width="900" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m5_from_nav" value="[FROM MODUL 1: NAVIGASI MANAJEMEN]" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="115" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m5_prep" value="PREPARATION (Manajemen Owner, Laporan Keuangan &amp; Backup Database):
[IPO Context]:
• Input: Filter Periode (Harian/Mingguan/Bulanan/Kustom), User Form, Store Profile, Trigger Backup
• Process: Laba Calculation (Omzet - Modal Beli), BCrypt Hash, Dump SQL Metadata Engine
• Output: Visual TrendChart, Spreadsheet Excel (.xlsx), Database Backup (.sql)
[Deklarasi Variabel]:
• Periode p = Periode.HARIAN; LocalDate fromDate, toDate
• BigDecimal omzet = ZERO, laba = ZERO; Path targetBackup = null" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="780" y="200" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="m5_dec_mod" value="Pilih Menu
Manajemen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="925" y="360" width="150" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m5_mod_lap" value="1. LAPORAN KEUANGAN:
LaporanPanel &amp; LaporanDao
Analisis Omzet, Laba &amp; Ekspor Excel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="550" y="475" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m5_mod_usr" value="2. KELOLA PENGGUNA:
UserPanel &amp; UserService
Kredensial &amp; Otorisasi Staf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#581C87;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="870" y="475" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m5_mod_set" value="3. PENGATURAN &amp; BACKUP:
PengaturanPanel &amp; BackupService
Profil Struk &amp; Dump SQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1190" y="475" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m5_inp_lap" value="Pilih Periode: [Harian] [Mingguan] [Bulanan] [Kustom]
Klik &#x27;Ekspor ke Excel&#x27;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="565" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m5_sub_lap_calc" value="LaporanDao.hitungMetrik():
• Omzet Bruto = Σ Total Transaksi
• Estimasi Laba Bersih = Σ (Subtotal - (Harga Beli × Qty))
• Total Transaksi &amp; Nilai Rata-rata per Nota
• Render TrendChart &amp; 4 Tab Laporan" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="645" width="320" height="95" as="geometry" />
        </mxCell>
        <mxCell id="m5_db_tx_read" value="Tabel transaksi &amp;
Tabel transaksi_item" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="652" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m5_doc_excel" value="File Spreadsheet Excel:
ExcelExporter.export() (.xlsx/CSV)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="550" y="770" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m5_inp_usr" value="UserPanel: Tambah / Edit / Reset Password / Hapus User" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="860" y="565" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m5_sub_usr_rules" value="UserService.simpan() &amp; hapus() Rules:
1. Username unik &amp; Password minimal 4 karakter
2. Enkripsi Password dengan BCrypt Hash
3. PROTEKSI: Dilarang menghapus/nonaktifkan Owner terakhir!" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#581C87;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="645" width="320" height="95" as="geometry" />
        </mxCell>
        <mxCell id="m5_db_usr_write" value="Tabel users
INSERT / UPDATE /
DELETE" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="890" y="770" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m5_inp_set" value="PengaturanPanel:
• Simpan Profil Toko (Nama, Telp, Alamat, Footer Struk)
• Klik &#x27;Backup Database Sekarang&#x27; -&gt; Pilih Path File" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1170" y="565" width="300" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m5_sub_backup" value="BackupService.backup(targetPath):
1. conn.getMetaData().getTables() -&gt; Baca 9 tabel MySQL
2. Loop tabel -&gt; SELECT * FROM [table]
3. Generate DML INSERT INTO [table] (...) VALUES (...)
4. Tulis file SQL UTF-8 ke disk: &#x27;giriatk_backup_yyyyMMdd.sql&#x27;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
