          <mxGeometry x="925" y="955" width="150" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m3_err_fsm" value="Dialog Peringatan:
&#x27;Status tidak bisa dimundurkan /
antrian yang sudah diambil terkunci!&#x27;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=11;align=center;" vertex="1" parent="1">
