  <diagram id="diag_mod_queue" name="Modul 3: Antrian Jasa Cetak &amp; State Machine">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m3_hdr" value="&lt;b&gt;MODUL 3: MANAJEMEN ANTRIAN JASA CETAK &amp; SIKLUS HIDUP FINITE STATE MACHINE (FSM)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#94A3B8;&quot;&gt;AntrianPanel.java, AntrianDao.java, AntrianDialog.java — Siklus: MENUNGGU → PROSES → SELESAI → DIAMBIL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontSize=15;align=center;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="25" width="900" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m3_from_nav" value="[FROM MODUL 1: NAVIGASI ANTRIAN]" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="115" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m3_from_pos" value="[FROM MODUL 2: TIKET POS]" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="115" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m3_prep" value="PREPARATION (Monitoring Antrian Jasa &amp; State Machine):
[IPO Context]:
• Input: TabFilter, Dropdown Status Antrian, AntrianDialog (Form Tambah/Edit)
• Process: Validasi Transisi Status (transisiDiizinkan), Update DB, Hitung KPI
• Output: Counter KPI (Menunggu/Proses/Selesai), Refresh Tabel Antrian Realtime
[Deklarasi Variabel]:
• String filter = &#x27;AKTIF&#x27;; List&lt;Antrian&gt; data = new ArrayList&lt;&gt;()
• StatusAntrian statusLama = null, statusBaru = null
• int countMenunggu = 0, countProses = 0, countSelesai = 0" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="200" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="m3_sub_load" value="Subroutine: reload()
Query Antrian dari DB &amp; Hitung Counter KPI" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#E0E7FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="360" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m3_db_read" value="Tabel antrian
SELECT a.*, l.nama
FROM antrian a ..." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1190" y="345" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m3_proc_kpi" value="Update Telemetry KPI Counter:
• Menunggu: Count(status == MENUNGGU)
• Proses: Count(status == PROSES)
• Siap Diambil: Count(status == SELESAI)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="440" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m3_inp_action" value="User Memilih Aksi di Panel Antrian:
(Filter Tab / Tambah Manual / Edit Data / Ubah Status / Hapus)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="810" y="540" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m3_dec_act" value="Pilihan Aksi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="925" y="620" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m3_act_filter" value="Ganti Filter TabBar:
[Semua Aktif] [Menunggu]
[Diproses] [Siap Diambil]
[Riwayat] [Semua]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="725" width="190" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m3_act_dialog" value="AntrianDialog:
Input Pelanggan, Layanan, Qty, Keterangan
INSERT / UPDATE antrian" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#581C87;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="725" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m3_act_del" value="Hapus Antrian:
Dialog Konfirmasi -&gt; DELETE antrian" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1080" y="725" width="210" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m3_fsm_swim" value="ATURAN VALIDASI TRANSISI STATUS (AntrianPanel.transisiDiizinkan):
1. MENUNGGU -&gt; PROSES (Mulai pengerjaan cetak)
2. PROSES -&gt; SELESAI (Selesai cetak, Set waktu_selesai = NOW())
3. SELESAI -&gt; DIAMBIL (Pesanan diserahkan ke pelanggan &amp; diarsipkan)
* VALIDASI: Status yang sudah DIAMBIL atau dimundurkan akan DITOLAK!" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
